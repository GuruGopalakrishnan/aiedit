# Database (SQLite for local dev; swap the provider in prisma/schema.prisma for Postgres in production)
DATABASE_URL="file:./dev.db"

# Transcription provider (OpenAI Whisper / Speech-to-Text API)
# Leave blank to run in mock transcription mode during development.
OPENAI_API_KEY=

# Local storage root. Subfolders (uploads/audio/renders/thumbnails) are created automatically.
STORAGE_ROOT=./storage

# Upload limits
MAX_UPLOAD_SIZE_MB=500
MAX_UPLOAD_DURATION_MIN=10
